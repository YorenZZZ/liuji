# Login is on by default. Set false only for a trusted, private LAN.
LIUJI_AUTH_REQUIRED=true
# Use the NAS LAN IP to expose it to the LAN. Default: localhost only.
LIUJI_BIND_IP=127.0.0.1
LIUJI_PORT=18910
# Exact browser origin; change to your own NAS LAN IP for LAN access.
LIUJI_PUBLIC_ORIGIN=http://127.0.0.1:18910
# Set true only when using HTTPS.
LIUJI_COOKIE_SECURE=false
